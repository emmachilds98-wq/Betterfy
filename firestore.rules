rules_version = '2';

// The shared tag table: artist tags that a listener's own Last.fm key just
// fetched, offered so the next person with the same gap does not have to ask
// again. The opposite posture to storage.rules — the whole point here is that
// the data is public, because every contribution is published in docs/tags.json
// within a day of arriving.
//
// Writes are unauthenticated. That is deliberate: requiring a sign-in to
// contribute a public API's answer would add an identity to a page whose entire
// sign-in story is one Spotify button, to protect data that is about to be
// committed to a public repo. So these rules are a shape check, not a trust
// boundary — the real validation is normaliseContribution() in merge-tags.mjs,
// which nothing reaches docs/tags.json without passing.

service cloud.firestore {
  match /databases/{database}/documents {

    match /tagContributions/{artistId} {

      // Readable because it is about to be public anyway, and because the merge
      // job then needs no service account and this repo needs no secret.
      allow read: if true;

      // Exactly the three fields the client sends, nothing else, and small.
      // `tags` is a JSON string rather than an array so the size cap below is
      // one check instead of a walk over nested values.
      allow create: if request.resource.data.keys().hasOnly(['tags', 'source', 'at'])
                    && request.resource.data.tags is string
                    && request.resource.data.tags.size() < 2000
                    && request.resource.data.source == 'lastfm'
                    && request.resource.data.at is int;

      // First contribution for an artist wins. No edits, no deletes, nothing to
      // reconcile, and no way to revise an answer after the merge job has read
      // it — the create-with-documentId the client uses simply bounces with a
      // 409 the second time, which is the intended outcome rather than an error.
      allow update, delete: if false;
    }

    // Cross-device sync: small, private, per-listener state (skip/reject
    // feedback, tag corrections, axis overrides) — never anyone else's
    // Spotify data, only what Betterfy itself derived from decisions made in
    // this app. The opposite trust model to tagContributions above: writes
    // here are authenticated (Firebase Anonymous Auth — no email, no
    // password, invisible to whoever is using the page), because this data
    // is not meant to be public.
    //
    // A sync group's id is a randomly generated UUID, generated locally and
    // never displayed — it is the real secret here, the same trust model as
    // an unguessable "anyone with the link" share. A short-lived linkCode is
    // only how a *second* device learns a group's id, so two people don't
    // have to read a UUID aloud to each other; knowing the code is what
    // grants access to it, the same trust model as a password-reset link.
    // See FIREBASE.md for the full design this implements.
    match /syncGroups/{groupId} {

      match /members/{uid} {
        // Any signed-in device can check membership; only its own uid can be
        // added, and only ever added, never edited or removed (leaving is
        // "start a new group" client-side, not a moderation action here).
        allow get: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }

      match /state/{doc} {
        allow read, write: if request.auth != null && exists(
          /databases/$(database)/documents/syncGroups/$(groupId)/members/$(request.auth.uid));
      }
    }

    match /linkCodes/{code} {
      // Exactly what createLinkCode() sends, nothing else. createdAt lets a
      // redeemer refuse an expired code client-side; rules alone cannot
      // cheaply express "reject if older than N" against a clock they do not
      // control, so that check is advisory, not the security boundary — the
      // security boundary is the code being short-lived *and* deleted by
      // whoever redeems it, same as any single-use link.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['groupId', 'createdAt'])
                    && request.resource.data.groupId is string
                    && request.resource.data.createdAt is int;
      allow get: if request.auth != null;
      // Redeemed codes are deleted by whoever redeems them; an unredeemed one
      // is harmless left in place past its own expiry, since nothing here
      // trusts createdAt for security — but any signed-in device may still
      // tidy one up.
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // Nothing else in this database is reachable. Stated rather than left
    // implicit: silence here is easy to misread as an oversight instead of a
    // decision.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
