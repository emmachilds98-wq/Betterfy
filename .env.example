# ---- Spotify Web API ----
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# ---- Last.fm ----
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_USERNAME=

# ---- Discogs ---- optional: fills genre gaps Last.fm has nothing on at all
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# ---- Shared tag table ---- optional: the browser build offers freshly-fetched
#      Last.fm tags for artists the shipped table does not cover, and
#      `npm run tags` folds them back into docs/tags.json. Leave both blank and
#      nothing is ever sent; the page behaves exactly as it did without them.
#      Both values are public — a Firebase web key names a project, it does not
#      authorise anything, and the Firestore rules do the real work. They are
#      baked into docs/index.html at build time, so they belong here only for
#      convenience.
TAGS_PROJECT=
TAGS_KEY=

# ---- Request access ---- optional: shown next to "use your own Spotify app"
#      whenever someone hits the development-mode allowlist, as a "Request
#      access" mailto link addressed here with their Spotify account email
#      pre-filled in the body. Leave blank and the link is never shown — no
#      contact address is baked in by default for anyone who forks this repo.
CONTACT_EMAIL=

# ---- App Check ---- optional: the shared-tag write (TAGS_PROJECT/TAGS_KEY,
#      above) is unauthenticated by design, which is also its one open door —
#      anyone can script it. App Check closes that without adding a sign-in,
#      by requiring a reCAPTCHA v3 solve before Firestore accepts the write.
#      Leave both blank and nothing changes: no reCAPTCHA script loads, no
#      token is requested, contributions work exactly as they always have.
#
#      To turn it on: create a reCAPTCHA v3 key at
#      https://www.google.com/recaptcha/admin (domain: your GitHub Pages host)
#      for APPCHECK_SITE_KEY, then in the Firebase console, App Check → your
#      web app → register it with that same key as the reCAPTCHA v3 provider.
#      APPCHECK_APP_ID is the Firebase *web app* id shown there (looks like
#      1:123456789012:web:abcdef0123456789) — not a secret, it just names the
#      app. Turn on enforcement for Cloud Firestore only after confirming in
#      the App Check console that real tokens are arriving (Monitor mode
#      first, Enforced once you're sure) — enforcing before that risks
#      rejecting every contribution, including your own.
APPCHECK_SITE_KEY=
APPCHECK_APP_ID=

# ---- MusicBrainz ---- optional identity glue, no key needed: enrich-lastfm.mjs
#      uses this to resolve a Spotify artist to a MusicBrainz id first, so the
#      Last.fm tag fetch that follows can ask by that exact id (mbid=) instead
#      of a name Last.fm's autocorrect might match onto a different, same-named
#      artist. MusicBrainz's usage policy asks for an identifiable contact in
#      the User-Agent on every request — this is that string, and it is only
#      ever sent to musicbrainz.org, never baked into the web build (the
#      lookup needs a custom header a browser fetch cannot set, so this stays
#      Node-only; see README). Leave blank and nothing changes: no MusicBrainz
#      request is ever made, and every artist is looked up by name exactly as
#      before this existed.
MUSICBRAINZ_CONTACT=

# Tempo and key come from your own Rekordbox collection export instead of an
# API — see `npm run rekordbox`. GetSongBPM (20% coverage) and Deezer (empty
# for most tracks tested) were tried and are not wired; nothing reads a key
# for either, so they are not listed here.
