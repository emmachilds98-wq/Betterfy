# ---- Spotify Web API ----
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# ---- Last.fm ----
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_USERNAME=

# ---- Discogs ---- optional: fills genre gaps Last.fm has nothing on at all
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# ---- Shared tag table ---- optional: the browser build offers freshly-fetched
#      Last.fm tags for artists the shipped table does not cover, and
#      `npm run tags` folds them back into docs/tags.json. Leave both blank and
#      nothing is ever sent; the page behaves exactly as it did without them.
#      Both values are public — a Firebase web key names a project, it does not
#      authorise anything, and the Firestore rules do the real work. They are
#      baked into docs/index.html at build time, so they belong here only for
#      convenience.
TAGS_PROJECT=
TAGS_KEY=

# ---- MusicBrainz: planned identity glue, no key, but its API requires a
#      contact string in the User-Agent. Nothing reads this yet. ----
MUSICBRAINZ_CONTACT=

# Tempo and key come from your own Rekordbox collection export instead of an
# API — see `npm run rekordbox`. GetSongBPM (20% coverage) and Deezer (empty
# for most tracks tested) were tried and are not wired; nothing reads a key
# for either, so they are not listed here.
